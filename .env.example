# Neon Postgres connection string (console.neon.tech -> project -> Connection Details).
# Free tier, no Hostinger Node.js slot used.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/content_engine?sslmode=require"

# Read-only bridge into the `yt` repo's database (its ingested/analyzed
# YouTube videos become a research source here). Use a read-only DB user.
# See scripts/pull-yt-insights.ts.
YT_DATABASE_URL="mysql://readonly_user:password@host:3306/yt_workspace"

# Posting layer (see src/lib/posting/README.md) — not required until you wire posting
AYRSHARE_API_KEY=

# Where generated media assets get stored/served from before posting
# (S3-compatible bucket, Hostinger file storage, etc.)
ASSET_STORAGE_BASE_URL=
